<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="Chemical Synthesizer"
    MinSize="300 220">
    <BoxContainer Orientation="Vertical" Margin="4" VerticalExpand="True">

        <Label Text="Tier" StyleClasses="LabelKeyText" Margin="0 0 0 2" />
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
            <Button Name="Tier1Button" Text="1 - Weak" HorizontalExpand="True" StyleClasses="OpenRight" />
            <Button Name="Tier2Button" Text="2 - Moderate" HorizontalExpand="True" />
            <Button Name="Tier3Button" Text="3 - Volatile" HorizontalExpand="True" StyleClasses="OpenLeft" />
        </BoxContainer>

        <PanelContainer StyleClasses="Inset" Margin="0 0 0 4" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="4" VerticalExpand="True">
                <Label Name="StatusLabel" Text="Ready" HorizontalAlignment="Center" />
                <ProgressBar Name="ProgressBar"
                             HorizontalExpand="True"
                             MaxValue="1"
                             SetHeight="16"
                             Margin="0 4 0 0" />
            </BoxContainer>
        </PanelContainer>

        <Button Name="SynthesizeButton" Text="Synthesize" HorizontalExpand="True" />

    </BoxContainer>
</DefaultWindow>
