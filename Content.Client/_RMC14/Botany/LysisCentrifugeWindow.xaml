<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:botany="clr-namespace:Content.Client._RMC14.Botany"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    MinWidth="520"
    MinHeight="480"
    SetSize="520 560">
    <BoxContainer Orientation="Horizontal" Margin="6" SeparationOverride="6">

        <!-- Left: seed portrait + seed actions -->
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#12141A" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" MinWidth="150" MaxWidth="150" Margin="8" SeparationOverride="4">
                <SpriteView Name="SeedSpriteView"
                            SetSize="64 64"
                            OverrideDirection="South"
                            Scale="2 2"
                            Stretch="Fit"
                            HorizontalAlignment="Center"
                            Margin="0 0 0 4" />
                <PanelContainer Name="SeedStatusPanel" Access="Public" HorizontalExpand="True" Margin="0 0 0 6" MinHeight="26">
                    <Label Name="SeedStatusLabel" Access="Public" Margin="6 1" HorizontalAlignment="Center" ClipText="True" />
                </PanelContainer>
                <ScrollContainer HScrollEnabled="False" VerticalExpand="True" Margin="0 0 0 6">
                    <GridContainer Name="SeedTraitsGrid" Access="Public" Columns="2" HSeparationOverride="6" VSeparationOverride="2" />
                </ScrollContainer>
                <Button Name="EjectSeedButton" HorizontalExpand="True" Margin="0 0 0 2" />
                <Button Name="ProcessSeedButton" HorizontalExpand="True" />
            </BoxContainer>
        </PanelContainer>

        <!-- Right: genome buffer, disc, gene sequences -->
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="4">

            <PanelContainer Name="GenomeHeader" Access="Public">
                <Label Text="GENOME BUFFER" FontColorOverride="#FFFFFF" Margin="6 2" />
            </PanelContainer>
            <PanelContainer Name="GenomeStatusPanel" Access="Public" Margin="0 3 0 0" MinHeight="26">
                <Label Name="GenomeNameLabel" Access="Public" Margin="6 1" VerticalAlignment="Center" />
            </PanelContainer>
            <botany:RMCBotanyMetricControl Name="DegradationMetric" Margin="0 3 0 0" />
            <Button Name="ClearBufferButton" HorizontalExpand="True" Margin="0 3 0 6" />

            <PanelContainer Name="DiscHeader" Access="Public">
                <Label Text="DATA DISC" FontColorOverride="#FFFFFF" Margin="6 2" />
            </PanelContainer>
            <BoxContainer Orientation="Horizontal" Margin="0 3 0 6">
                <PanelContainer Name="DiscStatusPanel" Access="Public" HorizontalExpand="True" MinHeight="26">
                    <Label Name="DiscStatusLabel" Access="Public" Margin="6 1" VerticalAlignment="Center" />
                </PanelContainer>
                <Button Name="EjectDiscButton" Margin="4 0 0 0" />
            </BoxContainer>

            <BoxContainer Name="GenesSection" Orientation="Vertical" VerticalExpand="True">
                <PanelContainer Name="GenesHeader" Access="Public">
                    <Label Text="GENE SEQUENCES" FontColorOverride="#FFFFFF" Margin="6 2" />
                </PanelContainer>
                <ScrollContainer HScrollEnabled="False" VerticalExpand="True" Margin="0 3 0 0">
                    <BoxContainer Name="GeneButtonsContainer"
                                  Orientation="Vertical"
                                  HorizontalExpand="True" />
                </ScrollContainer>
            </BoxContainer>

        </BoxContainer>

    </BoxContainer>
</controls:FancyWindow>
