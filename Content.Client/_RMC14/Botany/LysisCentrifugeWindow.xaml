<DefaultWindow
    xmlns="https://spacestation14.io"
    MinSize="440 520">
    <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True">

        <!-- Seed packet slot -->
        <PanelContainer StyleClasses="Inset" Margin="0 0 0 6">
            <BoxContainer Orientation="Vertical" Margin="6">
                <Label Text="{Loc rmc-centrifuge-seed-header}" StyleClasses="LabelKeyText" />
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                    <Label Name="SeedStatusLabel"
                           HorizontalExpand="True"
                           VerticalAlignment="Center" />
                    <Button Name="EjectSeedButton"
                            Text="{Loc rmc-centrifuge-eject-seed}"
                            StyleClasses="OpenRight"
                            Margin="4 0 0 0" />
                    <Button Name="ProcessSeedButton"
                            Text="{Loc rmc-centrifuge-process-seed}"
                            StyleClasses="OpenLeft" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Genome buffer -->
        <PanelContainer StyleClasses="Inset" Margin="0 0 0 6">
            <BoxContainer Orientation="Vertical" Margin="6">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc rmc-centrifuge-genome-header}"
                           StyleClasses="LabelKeyText"
                           HorizontalExpand="True" />
                    <Button Name="ClearBufferButton"
                            Text="{Loc rmc-centrifuge-clear-buffer}"
                            StyleClasses="ButtonSquare" />
                </BoxContainer>
                <Label Name="GenomeNameLabel" Margin="0 4 0 4" />
                <BoxContainer Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Text="{Loc rmc-centrifuge-degradation-label}"
                           VerticalAlignment="Center"
                           Margin="0 0 6 0" />
                    <ProgressBar Name="DegradationBar"
                                 HorizontalExpand="True"
                                 MaxValue="1"
                                 SetHeight="18"
                                 VerticalAlignment="Center">
                        <Label Name="DegradationLabel"
                               Margin="4 0"
                               VerticalAlignment="Center" />
                    </ProgressBar>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Disc slot -->
        <PanelContainer StyleClasses="Inset" Margin="0 0 0 8">
            <BoxContainer Orientation="Horizontal" Margin="6">
                <Label Text="{Loc rmc-centrifuge-disc-label}"
                       StyleClasses="LabelKeyText"
                       VerticalAlignment="Center" />
                <Label Name="DiscStatusLabel"
                       HorizontalExpand="True"
                       VerticalAlignment="Center"
                       Margin="6 0" />
                <Button Name="EjectDiscButton"
                        Text="{Loc rmc-centrifuge-eject-disc}"
                        StyleClasses="ButtonSquare" />
            </BoxContainer>
        </PanelContainer>

        <!-- Gene extraction list -->
        <Label Text="{Loc rmc-centrifuge-genes-header}"
               StyleClasses="LabelKeyText"
               Margin="0 0 0 4" />
        <ScrollContainer HScrollEnabled="False"
                         VerticalExpand="True"
                         MinHeight="120">
            <BoxContainer Name="GeneButtonsContainer"
                          Orientation="Vertical"
                          HorizontalExpand="True" />
        </ScrollContainer>

    </BoxContainer>
</DefaultWindow>
