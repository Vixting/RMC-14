<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    MinSize="340 380"
    SetSize="340 340">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#181C24" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="4" VerticalExpand="True">

            <PanelContainer Name="DiscHeader" Access="Public">
                <Label Text="FLORA DATA DISC" FontColorOverride="#FFFFFF" Margin="6 2" />
            </PanelContainer>
            <PanelContainer Name="DiscStatusPanel" Access="Public" Margin="0 3 0 0" MinHeight="26">
                <Label Name="DiscStatusLabel" Access="Public" Margin="6 1" VerticalAlignment="Center" />
            </PanelContainer>
            <Label Name="DiscSourceLabel"
                   StyleClasses="LabelSubText"
                   Margin="0 3 0 0" />
            <ScrollContainer HScrollEnabled="False"
                             VerticalExpand="True"
                             MinHeight="80"
                             Margin="0 2 0 6">
                <BoxContainer Name="DiscGenesContainer" Orientation="Vertical" />
            </ScrollContainer>

            <PanelContainer Name="SeedHeader" Access="Public">
                <Label Text="TARGET SEED" FontColorOverride="#FFFFFF" Margin="6 2" />
            </PanelContainer>
            <BoxContainer Orientation="Horizontal" Margin="0 3 0 0" VerticalAlignment="Center">
                <SpriteView Name="SeedSpriteView"
                            SetSize="26 26"
                            OverrideDirection="South"
                            Stretch="Fit"
                            VerticalAlignment="Center"
                            Margin="0 0 4 0" />
                <PanelContainer Name="SeedStatusPanel" Access="Public" HorizontalExpand="True" MinHeight="26">
                    <Label Name="SeedStatusLabel" Access="Public" Margin="6 1" VerticalAlignment="Center" />
                </PanelContainer>
            </BoxContainer>
            <ProgressBar Name="EditCountBar"
                         Access="Public"
                         HorizontalExpand="True"
                         MaxValue="1"
                         MinHeight="16"
                         Margin="0 3 0 0">
                <Label Name="EditCountLabel"
                       Access="Public"
                       Margin="6 0"
                       FontColorOverride="#000000" />
            </ProgressBar>

            <BoxContainer Orientation="Horizontal" Margin="0 6 0 0">
                <Button Name="ApplyButton" HorizontalExpand="True" Margin="0 0 2 0" />
                <Button Name="EjectButton" HorizontalExpand="True" Margin="2 0 0 0" />
            </BoxContainer>

        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
