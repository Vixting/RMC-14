uniform sampler2D SCREEN_TEXTURE;
uniform lowp int count;
uniform highp vec2[10] position;
uniform highp float[10] radius;
uniform highp float[10] sharpness;
uniform highp float[10] width;
uniform highp float[10] falloffPower;
uniform highp float[10] strength;

void fragment() {
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
    highp float aspect = SCREEN_PIXEL_SIZE.x / SCREEN_PIXEL_SIZE.y;
    highp vec2 coord = uv;
    highp float brighten = 0.0;

    for (int i = 0; i < count; ++i) {
        highp vec2 WaveCentre = position[i];
        highp vec2 Delta = vec2(uv.x - WaveCentre.x, (uv.y - WaveCentre.y) * aspect);
        highp float Dist = length(Delta);
        highp float Diff = Dist - radius[i];

        if (Dist > 0.0001 && abs(Diff * sharpness[i]) < 1.0) {
            highp float ScaleDiff = 1.0 - pow(abs(Diff * sharpness[i]), width[i]);
            highp float Scale = max(radius[i], 0.13) * max(Dist, 0.13);
            highp vec2 DiffTexCoord = normalize(uv - WaveCentre);
            coord += (DiffTexCoord * Diff * ScaleDiff * strength[i]) / (Scale * falloffPower[i]);
            brighten += ScaleDiff * strength[i] / (Scale * 40.0);
        }
    }

    highp vec4 Color = zTextureSpec(SCREEN_TEXTURE, coord);
    COLOR = Color + Color * brighten;
}
