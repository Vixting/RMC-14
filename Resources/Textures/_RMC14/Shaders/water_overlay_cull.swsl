uniform sampler2D cullMask;
uniform highp vec4 cullMaskUV;
uniform bool keepWhereOpaque;

varying highp vec2 cullMaskUVOut;

void vertex()
{
    cullMaskUVOut = mix(cullMaskUV.xy, cullMaskUV.zw, tCoord2);
}

const highp float maskSoftness = 0.06;
const highp float edgeSampleOffset = 0.02;
const highp float edgeGradientScale = 2.5;
const highp float highlightStrength = 0.3;

void fragment()
{
    highp vec2 maskMin = min(cullMaskUV.xy, cullMaskUV.zw);
    highp vec2 maskMax = max(cullMaskUV.xy, cullMaskUV.zw);
    highp vec2 texel = (maskMax - maskMin) * maskSoftness;
    highp vec2 edgeTexel = (maskMax - maskMin) * edgeSampleOffset;

    highp float maskAlpha = texture2D(cullMask, cullMaskUVOut).a;
    maskAlpha += texture2D(cullMask, clamp(cullMaskUVOut + vec2(texel.x, 0.0), maskMin, maskMax)).a;
    maskAlpha += texture2D(cullMask, clamp(cullMaskUVOut - vec2(texel.x, 0.0), maskMin, maskMax)).a;
    maskAlpha += texture2D(cullMask, clamp(cullMaskUVOut + vec2(0.0, texel.y), maskMin, maskMax)).a;
    maskAlpha += texture2D(cullMask, clamp(cullMaskUVOut - vec2(0.0, texel.y), maskMin, maskMax)).a;
    maskAlpha *= 0.2;

    highp float gx = texture2D(cullMask, clamp(cullMaskUVOut + vec2(edgeTexel.x, 0.0), maskMin, maskMax)).a
                   - texture2D(cullMask, clamp(cullMaskUVOut - vec2(edgeTexel.x, 0.0), maskMin, maskMax)).a;
    highp float gy = texture2D(cullMask, clamp(cullMaskUVOut + vec2(0.0, edgeTexel.y), maskMin, maskMax)).a
                   - texture2D(cullMask, clamp(cullMaskUVOut - vec2(0.0, edgeTexel.y), maskMin, maskMax)).a;
    highp float edge = clamp(length(vec2(gx, gy)) * edgeGradientScale, 0.0, 1.0);

    highp vec4 tex = zTexture(UV);
    highp float keep = keepWhereOpaque ? maskAlpha : (1.0 - maskAlpha);

    COLOR = vec4(tex.rgb + edge * highlightStrength, tex.a * keep);
}
