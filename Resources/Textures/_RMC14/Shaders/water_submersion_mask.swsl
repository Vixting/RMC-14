light_mode unshaded;
uniform highp float alphaModifier;
uniform sampler2D mask;
uniform highp vec4 maskUV;
uniform highp float spriteRotation;
const highp float postShadeScale = 1.25;
const highp float maskSoftness = 0.06;

void fragment()
{
    highp vec4 tex = zTexture(UV);
    highp vec2 unpaddedUV = (UV - vec2(0.5)) * postShadeScale + vec2(0.5);

    highp vec2 centered = unpaddedUV - vec2(0.5);
    highp float s = sin(-spriteRotation);
    highp float c = cos(-spriteRotation);
    highp vec2 derotated = vec2(centered.x * c - centered.y * s, centered.x * s + centered.y * c) + vec2(0.5);

    highp vec2 maskUVOut = mix(maskUV.xy, maskUV.zw, derotated);

    highp vec2 maskMin = min(maskUV.xy, maskUV.zw);
    highp vec2 maskMax = max(maskUV.xy, maskUV.zw);
    highp vec2 texel = (maskMax - maskMin) * maskSoftness;

    highp float maskAlpha = texture2D(mask, maskUVOut).a;
    maskAlpha += texture2D(mask, clamp(maskUVOut + vec2(texel.x, 0.0), maskMin, maskMax)).a;
    maskAlpha += texture2D(mask, clamp(maskUVOut - vec2(texel.x, 0.0), maskMin, maskMax)).a;
    maskAlpha += texture2D(mask, clamp(maskUVOut + vec2(0.0, texel.y), maskMin, maskMax)).a;
    maskAlpha += texture2D(mask, clamp(maskUVOut - vec2(0.0, texel.y), maskMin, maskMax)).a;
    maskAlpha *= 0.2;

    highp float modifier = mix(1.0, alphaModifier, maskAlpha);
    COLOR = vec4(tex.rgb, tex.a * modifier);
}
